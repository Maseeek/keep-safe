{
  "name": "keep-safe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Let a human complete an agent's browser login from their phone.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "bridge": "tsx packages/bridge/src/cli.ts",
    "mcp": "tsx packages/mcp/src/index.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "npm run typecheck && npm run build:web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run build:web",
    "agent:config": "tsx scripts/agent-config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "lucide-react": "1.58.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "3.6.7",
    "ws": "8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.0",
    "@types/ws": "^8.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
